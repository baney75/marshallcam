# MarshallCam configuration. Copy to .env and fill in real values.
# Never commit .env.

# HTTP server
PORT=3000
LISTEN_HOST=0.0.0.0
APP_NAME=MarshallCam
APP_TAGLINE=Two-way video intercom

# Station PIN (4-8 digits). Required.
STATION_PIN=123456

# Admin dashboard password. Leave empty to disable /max.
ADMIN_PASSWORD=changeme

# LiveKit (required)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=changemechangemechangemechangeme
LIVEKIT_URL_LOCAL=ws://127.0.0.1:7880
# Optional. Derived from SERVER_LAN_IP if unset.
LIVEKIT_URL_LAN=
LIVEKIT_URL_PUBLIC=wss://livekit.example.com
PUBLIC_HOSTNAMES=cam.example.com,livekit.example.com
SERVER_LAN_IP=192.168.1.50

# Optional Roku ECP TV control. Leave TV_IP empty to disable.
TV_IP=
TV_ECP_PORT=8060

# Optional AI proxy (opencode serve). Leave empty to disable.
ADMIN_AI_URL=

# Paths
FFMPEG_PATH=
DATA_DIR=
LOG_DIR=

# Sessions. If SESSION_SECRET is empty, one is generated in DATA_DIR/session-secret.
SESSION_SECRET=
STATION_TOKEN_TTL_DAYS=3650
SESSION_TTL_HOURS=720

# ICE servers JSON. Default: public Google STUN.
ICE_SERVERS_JSON=

# macOS kiosk / installer
LABEL_PREFIX=com.marshallcam
KIOSK_APP_PATH=
KIOSK_BUNDLE_ID=
GUARD_REOPEN_TAILSCALE=0
AV_INPUT_DEVICE=
AV_OUTPUT_DEVICE=
